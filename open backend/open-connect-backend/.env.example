NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
DATABASE_URL=postgresql://openconnect:openconnect_secret@localhost:5432/openconnect
DATABASE_SSL=false
DB_POOL_MAX=20
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGIN=http://localhost:8081
LOG_LEVEL=info
CACHE_TTL_SECONDS=300

# ── Google OAuth (optional — leave blank to disable the Google login button) ──
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI must be: <BACKEND_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public URL of your deployed frontend (used to redirect back after OAuth)
FRONTEND_URL=http://localhost:8081
