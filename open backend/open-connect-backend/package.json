{
  "name": "open-connect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Production Fastify backend for Open Connect",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && mkdir -p dist/database/migrations && cp -r src/database/migrations/* dist/database/migrations/",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "seed": "tsx src/database/seeds/seed.ts",
    "test": "jest --runInBand",
    "setup:local": "powershell -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "setup:local:unix": "sh scripts/setup-local.sh",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.53.2",
    "dotenv": "^16.5.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.29",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
